# Shared existing Supabase project: builder (eu-west-1)
NEXT_PUBLIC_SUPABASE_URL=https://gbqviddfwdgyiqueaaev.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
# Server-side worker ONLY. Do not add this with NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://gbqviddfwdgyiqueaaev.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
BEATFORGE_STORAGE_BUCKET=beatforge-media
BEATFORGE_WORKER_API_KEY=replace_with_long_random_secret
DEMUCS_MODEL=htdemucs
BEATFORGE_DEVICE=cpu
BEATFORGE_CPU_THREADS=2
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: ACE-Step 1.5 inference server for full AI song generation.
# Audio analysis, stem separation, transcription and MIDI production work without this GPU service.
ACESTEP_API_URL=https://your-acestep-gpu-service.example
ACESTEP_API_KEY=replace_with_acestep_api_key
ACESTEP_MODEL=acestep-v15-turbo
